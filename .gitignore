# dependencies
node_modules/

# build output - all generated, none of it belongs in the repository
dist/
dist-electron/
dist-preview/
dist-preview-overlay/
preview-dist/
release/
# 备用输出目录：release 里的 app.asar 被系统句柄占住、builder 删不掉时改道到这里。
release2/

# logs and local crash reports
*.log
npm-debug.log*
yarn-error.log*

# editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# local tooling artifacts
.dsh-vision-toolkit/
*.tsbuildinfo

# local test output and env files.
# The project has neither lint nor .env today; listed so that adding either later
# cannot leak a cache or a secret through a stray `git add -A`.
coverage/
.eslintcache
.env
.env.*.local

# Local npm registry mirror configuration.
#
# Deliberately not published: it points npm and the Electron downloader at a
# third-party mirror, which would be imposed on everyone who clones this, and the
# electron_* keys are not npm config keys, so npm prints a warning for each of
# them on every single command. The README documents the same settings for anyone
# who needs the mirror.
.npmrc

# Performance probe output.
#
# The reports and scripts are checked in - they are small, and the measured
# numbers are the point. The raw artifacts are not: A/B screenshots are ~4 MB per
# run and the GPU dumps are regenerated by the same script that reads them, so
# keeping them would grow the repository on every measurement without recording
# anything the markdown reports do not already say.
docs/shots/
docs/gpu-composite-probe.json
docs/gpu-screen-inventory.json

# Real-window smoke output.
#
# The walk writes one screenshot per screen and keeps a throwaway user-data-dir so
# it never touches the settings the app is actually using. Both are regenerated on
# every run; the seeded library is a handful of synthetic one-second files.
.smoke/
shots/
.probe-*
.perf/
.perf-*

# 参考仓库的 README 与源码摘录，读的时候抓下来，不随项目入库。
.refs/

# Unpacked copy of an installed build, used to diff a shipped version against
# the repository. Temporary by nature; the extract is 60+ MB.
.installed*/

# 第三方音源服务（KuGouMusicApi）是外部仓库，按需 vendor 进来，不入库。
vendor/

# 设计过程中的预览页与截图，只在本机看，不进仓库。
design/

# 单文件跑 tsc 会把这些 .ts 的产物丢在源码旁边，不该进仓库。
src/**/*.js
src/**/*.js.map

# 截图与探针写的临时用户数据目录，以及调试截图（曾被误提交过一次）。
.driver/

# electron-builder 的备用输出目录，与 release/ 同类。
release-dir/
release-*/


.commit-msg.txt
