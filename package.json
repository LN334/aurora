{
  "name": "aurora-player",
  "private": true,
  "version": "0.7.5",
  "description": "把网易云、QQ 音乐、酷狗、汽水拼成一个曲库的 Windows 桌面客户端：同曲合并、按音源优先级播放，首页是会转的封面墙，漫游是一条放不完的推荐流",
  "author": "Aurora contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LN334/aurora.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "clean:electron": "node scripts/clean-electron.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "build:electron": "npm run clean:electron && tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && vite build",
    "preview": "vite build --config vite.preview.config.ts && vite build --config vite.preview-overlay.config.ts && node scripts/inline-preview.mjs",
    "perf": "node scripts/perf-report.mjs",
    "perf:dom": "node scripts/measure-dom.mjs",
    "icons": "node scripts/make-icons.mjs",
    "asar": "node scripts/asar-probe.mjs",
    "scan": "node scripts/scan-probe.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run test && node scripts/audit-reachability.mjs && node scripts/audit-css.mjs && node scripts/audit-stale-paths.mjs && node scripts/audit-exports.mjs",
    "audit:exports": "node scripts/audit-exports.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.aurora.player",
    "productName": "Aurora",
    "copyright": "Copyright © 2026 LN334",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/music-metadata/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "LN334",
      "repo": "aurora"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aurora",
      "deleteAppDataOnUninstall": false,
      "language": "2052",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "extraResources": [
      {
        "from": "vendor/KuGouMusicApi",
        "to": "KuGouMusicApi",
        "filter": [
          "**/*",
          "!**/.github/**",
          "!**/docs/**",
          "!**/.git/**",
          "!**/*.md"
        ]
      },
      {
        "from": "vendor/KuGouMusicApi/node_modules",
        "to": "KuGouMusicApi/node_modules",
        "filter": [
          "**/*",
          "!typescript/**",
          "!@rolldown/**",
          "!prettier/**",
          "!@babel/**",
          "!@types/**",
          "!nodemon/**",
          "!ts-node/**",
          "!tsdown/**",
          "!pkg/**",
          "!**/*.md",
          "!**/*.map"
        ]
      }
    ]
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "^4.41.1",
    "@sansenjian/qq-music-api": "^2.6.0",
    "electron-updater": "^6.8.9",
    "music-metadata": "^11.9.0",
    "qishui-music-api": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.1",
    "webwallgl": "^3.0.1",
    "zustand": "^5.0.0"
  }
}
